generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String          @id @default(uuid())
  email            String          @unique
  password         String
  name             String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  resetToken       String?
  resetTokenExpiry DateTime?
  isAdmin          Boolean         @default(false)
  address          String?
  phone            String?
  unit             String?
  documents        Document[]
  sessions         Session[]
  unitUpdates      UnitUpdate[]
  notifications    Notification[]
  payments         Payment[]
  userProperties   UserProperty[]
  changeRequests   ChangeRequest[]
  referralCodes    ReferralCode[]
  referrals        Referral[]
  addonQuotes      AddonQuote[]

  @@index([email])
}

model Document {
  id        String   @id @default(uuid())
  title     String
  type      String
  fileUrl   String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UnitUpdate {
  id          String     @id @default(uuid())
  userId      String
  updateType  UpdateType @default(GENERAL)
  title       String
  description String
  time        String
  publishedAt DateTime   @default(now())
  isPublished Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([publishedAt(sort: Desc)])
  @@index([isPublished])
  @@index([updateType])
  @@map("UnitUpdate")
}

model CompanyNews {
  id          String       @id @default(uuid())
  category    NewsCategory @default(ANNOUNCEMENT)
  title       String
  description String
  time        String
  publishedAt DateTime     @default(now())
  isPublished Boolean      @default(true)
  isFeatured  Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([publishedAt(sort: Desc)])
  @@index([isPublished])
  @@index([category])
  @@index([isFeatured])
  @@map("CompanyNews")
}

model Property {
  id                   String              @id @default(uuid())
  name                 String
  location             String
  propertyType         PropertyType
  imageUrl             String?
  bedrooms             Int
  area                 Float
  status               PropertyStatus      @default(UNDER_CONSTRUCTION)
  completionPercentage Float               @default(0)
  currentPhase         String?
  estimatedCompletion  String?
  floor                String?
  parking              String?
  balcony              String?
  furnishedStatus      String?
  amenities            String[]            @default([])
  downPayment          Float?
  constructionPayment  Float?
  handoverPayment      Float?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  payments             Payment[]
  timelineMilestones   TimelineMilestone[]
  userProperties       UserProperty[]
  changeRequests       ChangeRequest[]
  addonQuotes          AddonQuote[]

  @@index([status])
  @@index([propertyType])
  @@map("property")
}

model UserProperty {
  id         String   @id @default(uuid())
  userId     String
  propertyId String
  unitCode   String
  isPrimary  Boolean  @default(false)
  assignedAt DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([userId])
  @@index([propertyId])
  @@map("user_property")
}

model TimelineMilestone {
  id                   String            @id @default(uuid())
  propertyId           String
  phase                String
  title                String
  description          String?
  status               MilestoneStatus   @default(PENDING)
  completionPercentage Int               @default(0)
  completedDate        DateTime?
  estimatedDate        String?
  orderIndex           Int               @default(0)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  property             Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  updates              MilestoneUpdate[]
  photos               MilestonePhoto[]

  @@index([propertyId])
  @@index([status])
  @@index([orderIndex])
  @@map("timeline_milestone")
}

model MilestoneUpdate {
  id          String            @id @default(uuid())
  milestoneId String
  notes       String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  milestone   TimelineMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  photos      MilestonePhoto[]

  @@index([milestoneId])
  @@index([createdAt(sort: Desc)])
  @@map("milestone_update")
}

model MilestonePhoto {
  id                String           @id @default(uuid())
  milestoneId       String
  milestoneUpdateId String?
  photoUrl          String
  caption           String?
  photoType         PhotoType        @default(PROGRESS)
  createdAt         DateTime         @default(now())
  milestone         TimelineMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  milestoneUpdate   MilestoneUpdate?  @relation(fields: [milestoneUpdateId], references: [id], onDelete: Cascade)

  @@index([milestoneId])
  @@index([milestoneUpdateId])
  @@map("milestone_photo")
}

model AddonOffer {
  id          String        @id @default(uuid())
  title       String
  description String
  imageUrl    String?
  icon        String?
  price       Float?
  category    AddonCategory @default(OTHER)
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  quoteItems  AddonQuoteItem[]

  @@index([isActive])
  @@index([category])
  @@map("addon_offer")
}

model AddonQuote {
  id          String            @id @default(uuid())
  userId      String
  propertyId  String
  totalPrice  Float
  status      AddonQuoteStatus  @default(PENDING)
  adminNotes  String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  property    Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  items       AddonQuoteItem[]

  @@index([userId])
  @@index([propertyId])
  @@index([status])
  @@map("addon_quote")
}

model AddonQuoteItem {
  id           String     @id @default(uuid())
  quoteId      String
  addonOfferId String
  price        Float
  quote        AddonQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  addonOffer   AddonOffer @relation(fields: [addonOfferId], references: [id], onDelete: Cascade)

  @@map("addon_quote_item")
}

enum AddonQuoteStatus {
  PENDING
  REVIEWED
  APPROVED
  REJECTED
}

model Payment {
  id                String        @id @default(uuid())
  userId            String
  propertyId        String?
  amount            Float
  currency          String        @default("AED")
  paymentType       PaymentType
  status            PaymentStatus @default(PENDING)
  dueDate           DateTime?
  paidDate          DateTime?
  description       String?
  invoiceNumber     String?
  receiptUrl        String?
  installmentNumber Int?
  totalInstallments Int?
  percentage        Float?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  paymentGateway    String?
  paymentMethod     String?
  transactionId     String?       @unique
  property          Property?     @relation(fields: [propertyId], references: [id])
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([propertyId])
  @@index([status])
  @@index([dueDate])
  @@map("payment")
}

model Notification {
  id              String           @id @default(uuid())
  userId          String
  title           String
  message         String
  type            NotificationType @default(SYSTEM)
  isRead          Boolean          @default(false)
  relatedEntityId String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@index([isRead])
  @@map("notification")
}


enum UpdateType {
  ELECTRICAL
  PLUMBING
  CONSTRUCTION
  INSPECTION
  MILESTONE
  GENERAL
}

enum NewsCategory {
  ANNOUNCEMENT
  AWARD
  EVENT
  SUSTAINABILITY
  COMMUNITY
}

enum PropertyType {
  VILLA
  APARTMENT
  TOWNHOUSE
  PENTHOUSE
}

enum PropertyStatus {
  UNDER_CONSTRUCTION
  READY
  HANDOVER_COMPLETE
}

enum MilestoneStatus {
  COMPLETED
  IN_PROGRESS
  PENDING
  DELAYED
}

enum AddonCategory {
  UPGRADE
  SMART_HOME
  OUTDOOR
  VEHICLE
  SECURITY
  OTHER
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentType {
  INSTALLMENT
  MAINTENANCE_FEE
  SERVICE_CHARGE
  ADDON_PAYMENT
  OTHER
}

enum NotificationType {
  PAYMENT
  DOCUMENT
  UNIT_UPDATE
  COMPANY_NEWS
  CONSTRUCTION
  SYSTEM
  CHANGE_REQUEST
  REFERRAL
}

enum PhotoType {
  BEFORE
  AFTER
  PROGRESS
}


// ─────────────── Change Requests ───────────────

enum ChangeRequestCategory {
  STRUCTURAL
  INTERIOR
  ELECTRICAL
  PLUMBING
  LAYOUT
  MATERIAL
  OTHER
}

enum ChangeRequestStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  COMPLETED
}

model ChangeRequest {
  id             String                @id @default(uuid())
  userId         String
  propertyId     String
  title          String
  description    String
  category       ChangeRequestCategory
  status         ChangeRequestStatus   @default(SUBMITTED)
  adminNotes     String?
  costImpact     Float?
  timelineImpact String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  property       Property              @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([propertyId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("change_request")
}

// ─────────────── Referrals ───────────────

enum ReferralStatus {
  PENDING
  VERIFIED
  REWARD_APPLIED
  REJECTED
}

model ReferralCode {
  id        String     @id @default(uuid())
  userId    String
  code      String     @unique
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  referrals Referral[]

  @@index([userId])
  @@index([code])
  @@map("referral_code")
}

model Referral {
  id                   String         @id @default(uuid())
  referrerId           String
  referralCodeId       String
  referredName         String
  referredPhone        String
  referredEmail        String?
  status               ReferralStatus @default(PENDING)
  rewardAmount         Float          @default(50000)
  appliedToInstallment Int?
  adminNotes           String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  referrer             User           @relation(fields: [referrerId], references: [id], onDelete: Cascade)
  referralCode         ReferralCode   @relation(fields: [referralCodeId], references: [id])

  @@index([referrerId])
  @@index([referralCodeId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("referral")
}
