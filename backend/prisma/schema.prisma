generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String          @id @default(uuid())
  email            String          @unique
  password         String
  name             String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  resetToken       String?
  resetTokenExpiry DateTime?
  isAdmin          Boolean         @default(false)
  address          String?
  phone            String?
  unit             String?
  documents        Document[]
  sessions         Session[]
  unitUpdates      UnitUpdate[]
  notifications    Notification[]
  payments         Payment[]
  savedDesigns     SavedDesign[]
  userProperties   UserProperty[]
  userDesigns      UserDesign[]
  wishlists        Wishlist[]

  @@index([email])
}

model Document {
  id        String   @id @default(uuid())
  title     String
  type      String
  fileUrl   String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UnitUpdate {
  id          String     @id @default(uuid())
  userId      String
  updateType  UpdateType @default(GENERAL)
  title       String
  description String
  time        String
  publishedAt DateTime   @default(now())
  isPublished Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([publishedAt(sort: Desc)])
  @@index([isPublished])
  @@index([updateType])
  @@map("UnitUpdate")
}

model CompanyNews {
  id          String       @id @default(uuid())
  category    NewsCategory @default(ANNOUNCEMENT)
  title       String
  description String
  time        String
  publishedAt DateTime     @default(now())
  isPublished Boolean      @default(true)
  isFeatured  Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([publishedAt(sort: Desc)])
  @@index([isPublished])
  @@index([category])
  @@index([isFeatured])
  @@map("CompanyNews")
}

model Property {
  id                   String              @id @default(uuid())
  name                 String
  location             String
  propertyType         PropertyType
  imageUrl             String?
  bedrooms             Int
  area                 Float
  status               PropertyStatus      @default(UNDER_CONSTRUCTION)
  completionPercentage Float               @default(0)
  currentPhase         String?
  estimatedCompletion  String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  payments             Payment[]
  timelineMilestones   TimelineMilestone[]
  userProperties       UserProperty[]

  @@index([status])
  @@index([propertyType])
  @@map("property")
}

model UserProperty {
  id         String   @id @default(uuid())
  userId     String
  propertyId String
  unitCode   String
  isPrimary  Boolean  @default(false)
  assignedAt DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([userId])
  @@index([propertyId])
  @@map("user_property")
}

model TimelineMilestone {
  id                   String            @id @default(uuid())
  propertyId           String
  phase                String
  title                String
  description          String?
  status               MilestoneStatus   @default(PENDING)
  completionPercentage Int               @default(0)
  completedDate        DateTime?
  estimatedDate        String?
  orderIndex           Int               @default(0)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  property             Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  updates              MilestoneUpdate[]
  photos               MilestonePhoto[]

  @@index([propertyId])
  @@index([status])
  @@index([orderIndex])
  @@map("timeline_milestone")
}

model MilestoneUpdate {
  id          String            @id @default(uuid())
  milestoneId String
  notes       String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  milestone   TimelineMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  photos      MilestonePhoto[]

  @@index([milestoneId])
  @@index([createdAt(sort: Desc)])
  @@map("milestone_update")
}

model MilestonePhoto {
  id                String           @id @default(uuid())
  milestoneId       String
  milestoneUpdateId String?
  photoUrl          String
  caption           String?
  photoType         PhotoType        @default(PROGRESS)
  createdAt         DateTime         @default(now())
  milestone         TimelineMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  milestoneUpdate   MilestoneUpdate?  @relation(fields: [milestoneUpdateId], references: [id], onDelete: Cascade)

  @@index([milestoneId])
  @@index([milestoneUpdateId])
  @@map("milestone_photo")
}

model AddonOffer {
  id          String        @id @default(uuid())
  title       String
  description String
  imageUrl    String?
  icon        String?
  price       Float?
  category    AddonCategory @default(OTHER)
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([isActive])
  @@index([category])
  @@map("addon_offer")
}

model Payment {
  id                String        @id @default(uuid())
  userId            String
  propertyId        String?
  amount            Float
  currency          String        @default("AED")
  paymentType       PaymentType
  status            PaymentStatus @default(PENDING)
  dueDate           DateTime?
  paidDate          DateTime?
  description       String?
  invoiceNumber     String?
  receiptUrl        String?
  installmentNumber Int?
  totalInstallments Int?
  percentage        Float?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  paymentGateway    String?
  paymentMethod     String?
  transactionId     String?       @unique
  property          Property?     @relation(fields: [propertyId], references: [id])
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([propertyId])
  @@index([status])
  @@index([dueDate])
  @@map("payment")
}

model Notification {
  id              String           @id @default(uuid())
  userId          String
  title           String
  message         String
  type            NotificationType @default(SYSTEM)
  isRead          Boolean          @default(false)
  relatedEntityId String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@index([isRead])
  @@map("notification")
}

model SavedDesign {
  id          String   @id @default(uuid())
  userId      String
  imageUrl    String
  roomType    String
  designStyle String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@map("saved_design")
}

model ShowroomTemplate {
  id              String          @id @default(uuid())
  name            String
  description     String?
  roomType        RoomType
  style           ShowroomStyle
  furnishingLevel FurnishingLevel @default(EMPTY)
  thumbnailUrl    String?
  modelUrl        String
  previewImages   String[]        @default([])
  floorDimensions Json?
  defaultItems    Json?
  isActive        Boolean         @default(true)
  sortOrder       Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  userDesigns     UserDesign[]

  @@index([roomType])
  @@index([style])
  @@index([furnishingLevel])
  @@index([isActive])
  @@map("showroom_template")
}

model FurnitureProduct {
  id            String          @id @default(uuid())
  name          String
  description   String?
  category      ProductCategory
  subcategory   String?
  brand         String?
  price         Float?
  currency      String          @default("AED")
  thumbnailUrl  String
  modelUrl      String
  dimensions    Json?
  colorOptions  Json?
  tags          String[]        @default([])
  isActive      Boolean         @default(true)
  isFeatured    Boolean         @default(false)
  sortOrder     Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  designItems   DesignItem[]
  wishlistItems WishlistItem[]

  @@index([category])
  @@index([isActive])
  @@index([isFeatured])
  @@index([price])
  @@map("furniture_product")
}

model UserDesign {
  id           String           @id @default(uuid())
  userId       String
  showroomId   String
  name         String
  thumbnailUrl String?
  sceneState   Json?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  showroom     ShowroomTemplate @relation(fields: [showroomId], references: [id])
  items        DesignItem[]
  wishlist     Wishlist?

  @@index([userId])
  @@index([showroomId])
  @@index([updatedAt(sort: Desc)])
  @@map("user_design")
}

model DesignItem {
  id        String           @id @default(uuid())
  designId  String
  productId String
  positionX Float            @default(0)
  positionY Float            @default(0)
  positionZ Float            @default(0)
  rotationX Float            @default(0)
  rotationY Float            @default(0)
  rotationZ Float            @default(0)
  scaleX    Float            @default(1)
  scaleY    Float            @default(1)
  scaleZ    Float            @default(1)
  colorOption String?
  createdAt DateTime         @default(now())
  design    UserDesign       @relation(fields: [designId], references: [id], onDelete: Cascade)
  product   FurnitureProduct @relation(fields: [productId], references: [id])

  @@index([designId])
  @@index([productId])
  @@map("design_item")
}

model Wishlist {
  id        String         @id @default(uuid())
  designId  String         @unique
  userId    String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  design    UserDesign     @relation(fields: [designId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]

  @@index([userId])
  @@map("wishlist")
}

model WishlistItem {
  id         String           @id @default(uuid())
  wishlistId String
  productId  String
  quantity   Int              @default(1)
  notes      String?
  createdAt  DateTime         @default(now())
  wishlist   Wishlist         @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product    FurnitureProduct @relation(fields: [productId], references: [id])

  @@unique([wishlistId, productId])
  @@index([wishlistId])
  @@map("wishlist_item")
}

enum UpdateType {
  ELECTRICAL
  PLUMBING
  CONSTRUCTION
  INSPECTION
  MILESTONE
  GENERAL
}

enum NewsCategory {
  ANNOUNCEMENT
  AWARD
  EVENT
  SUSTAINABILITY
  COMMUNITY
}

enum PropertyType {
  VILLA
  APARTMENT
  TOWNHOUSE
  PENTHOUSE
}

enum PropertyStatus {
  UNDER_CONSTRUCTION
  READY
  HANDOVER_COMPLETE
}

enum MilestoneStatus {
  COMPLETED
  IN_PROGRESS
  PENDING
  DELAYED
}

enum AddonCategory {
  UPGRADE
  SMART_HOME
  OUTDOOR
  VEHICLE
  SECURITY
  OTHER
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentType {
  INSTALLMENT
  MAINTENANCE_FEE
  SERVICE_CHARGE
  ADDON_PAYMENT
  OTHER
}

enum NotificationType {
  PAYMENT
  DOCUMENT
  UNIT_UPDATE
  COMPANY_NEWS
  CONSTRUCTION
  SYSTEM
}

enum PhotoType {
  BEFORE
  AFTER
  PROGRESS
}

enum ProductCategory {
  SOFA
  BED
  TABLE
  CHAIR
  STORAGE
  LIGHTING
  RUG
  DECOR
  PLANT
  KITCHEN_FIXTURE
  BATHROOM_FIXTURE
}

enum RoomType {
  LIVING_ROOM
  BEDROOM
  KITCHEN
  BATHROOM
  OFFICE
  DINING_ROOM
}

enum ShowroomStyle {
  MODERN
  SCANDINAVIAN
  MINIMALIST
  TRADITIONAL
  INDUSTRIAL
  BOHEMIAN
}

enum FurnishingLevel {
  EMPTY
  SEMI_FURNISHED
  FULLY_FURNISHED
}
